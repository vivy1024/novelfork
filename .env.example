# NovelFork Environment Configuration
# Copy to .env and fill in your values

# LLM Provider (openai, anthropic, custom)
NOVELFORK_LLM_PROVIDER=openai

# API Base URL (OpenAI-compatible endpoint)
NOVELFORK_LLM_BASE_URL=https://api.openai.com/v1

# API Key
NOVELFORK_LLM_API_KEY=sk-your-key-here

# Model name
NOVELFORK_LLM_MODEL=gpt-4o

# Notifications (optional)
NOVELFORK_TELEGRAM_BOT_TOKEN=
NOVELFORK_TELEGRAM_CHAT_ID=
NOVELFORK_FEISHU_WEBHOOK_URL=
NOVELFORK_WECOM_WEBHOOK_URL=
