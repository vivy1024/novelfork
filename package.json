{
  "name": "novelfork",
  "version": "3.2.0",
  "private": true,
  "description": "NovelFork — Forked from InkOS, specialized AI-assisted workbench for Chinese web novel creation",
  "keywords": [
    "ai-novel-writing",
    "web-novel",
    "chinese-novel",
    "novel-generator",
    "autonomous-writing",
    "xuanhuan",
    "xianxia",
    "multi-agent",
    "creative-writing-ai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vivy1024/novelfork"
  },
  "scripts": {
    "build": "bun scripts/build-product-frontend.ts",
    "dev": "bun --watch main.ts",
    "dev:frontend": "bun run --cwd packages/studio dev",
    "start": "bun run main.ts",
    "compile": "bun scripts/compile-product-runtime.ts --platform=windows-x64",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "bun:main": "bun run start",
    "bun:build-client": "bun scripts/build-product-frontend.ts",
    "bun:compile": "bun run compile",
    "docs:verify": "bun run scripts/verify-docs.ts",
    "architecture:check": "bun run scripts/verify-package-boundaries.ts",
    "runtime:parity:verify": "bun run scripts/verify-runtime-product-parity.ts",
    "runtime:parity:bench": "bun run runtime:parity:verify && bun run --cwd packages/narrafork-runtime-private tests/server/perf/novelfork-product-baseline.ts && pnpm --dir packages/studio run bench:runtime-product",
    "codegraph": "bun run scripts/build-codegraph.ts",
    "docs:drift": "bun run scripts/codegraph/doc-drift.ts",
    "verify:publish-manifests": "node scripts/verify-no-workspace-protocol.mjs packages/core",
    "release": "pnpm build && pnpm test",
    "version": "pnpm -r exec npm version"
  },
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "fuzzysort": "3.1.0",
    "glob": "13.0.6",
    "idb": "8.0.3",
    "prosemirror-state": "1.4.4",
    "tiktoken": "1.0.22"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "esbuild": "0.28.0"
  },
  "overrides": {
    "@tiptap/core": "2.27.2",
    "@tiptap/pm": "2.27.2",
    "@tiptap/extension-code-block": "2.27.2",
    "@tiptap/extension-text-style": "2.27.2",
    "@tiptap/react": "2.27.2",
    "@tiptap/starter-kit": "2.27.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "workspaces": [
    "packages/*",
    "!packages/desktop"
  ]
}
