#!/bin/sh
# 推送前检查即将推送的每个提交（公开仓库一旦推上去，删文件也收不回历史）。
# 启用（每个克隆执行一次）：git config core.hooksPath .githooks
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # 删除远端分支，无内容可查
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    # 新分支：从它与已推送历史的分叉点开始查。
    base=$(git merge-base "$local_sha" refs/remotes/origin/HEAD 2>/dev/null || git merge-base "$local_sha" refs/remotes/origin/master 2>/dev/null)
  fi
  if [ -n "$base" ]; then
    node scripts/check-public-boundary.mjs --range "$base..$local_sha" || status=1
  else
    echo "找不到与远端的分叉点，跳过范围检查（$local_ref）。" >&2
  fi
done
[ "$status" -eq 0 ] && node scripts/check-public-boundary.mjs || status=1
exit $status
