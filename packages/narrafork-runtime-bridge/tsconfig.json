{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun-types"],
    "typeRoots": [
      "../narrafork-runtime-private/node_modules/@types",
      "../narrafork-runtime-private/node_modules"
    ],
    "baseUrl": "../narrafork-runtime-private",
    "paths": {
      "@server/*": ["server/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "../narrafork-runtime-private/server/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
