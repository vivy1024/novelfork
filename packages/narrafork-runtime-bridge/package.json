{
  "name": "@vivy1024/narrafork-runtime-bridge",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime-db": {
      "types": "./src/runtime-db.ts",
      "import": "./src/runtime-db.ts",
      "default": "./src/runtime-db.ts"
    },
    "./frontend/narrator-panel": {
      "types": "./src/frontend/narrator-panel.ts",
      "import": "./src/frontend/narrator-panel.ts",
      "default": "./src/frontend/narrator-panel.ts"
    },
    "./frontend/query-client": {
      "types": "./src/frontend/query-client.ts",
      "import": "./src/frontend/query-client.ts",
      "default": "./src/frontend/query-client.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "typescript": "^5.9.3"
  }
}
